{
  "name": "chult-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK app for chult.oolong.com",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"**/*.{js,ts,tsx,jsx,json,css,md,yml,yaml}\" --ignore-path ../.prettierignore",
    "test": "bash ./tests/infra-down.test.sh && bash ./tests/infra-up.test.sh",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "infra:up": "./scripts/infra-up.sh",
    "infra:down": "./scripts/infra-down.sh",
    "ecr:push": "./scripts/push-ecr-image.sh",
    "dynamodb:export": "./scripts/dynamodb-export.sh",
    "dynamodb:import": "./scripts/dynamodb-import.sh"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "aws-cdk": "2.1105.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.238.0",
    "constructs": "10.4.2"
  }
}
